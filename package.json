{
  "name": "fairshiftai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "paypal:check": "tsx scripts/paypal-check.ts",
    "paypal:test-payout": "tsx scripts/paypal-test-payout.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "ai:ping": "tsx scripts/ai-ping.ts",
    "demo:db": "docker run -d --name fairshift-demo-db -e POSTGRES_PASSWORD=fairshift-local -p 127.0.0.1:5432:5432 postgres:16-alpine && until docker exec fairshift-demo-db pg_isready -U postgres >/dev/null 2>&1; do sleep 1; done && echo '✓ Local demo database is running (inside this Codespace only)'",
    "demo:db:reset": "docker rm -f fairshift-demo-db >/dev/null 2>&1; npm run demo:db",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "paypal:preflight": "tsx scripts/paypal-preflight.ts",
    "demo:app": "tsx scripts/demo-guard.ts && next build && next start -p 3000"
  },
  "dependencies": {
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "openai": "^7.48.0",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
