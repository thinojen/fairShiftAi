# Copy to .env.local for local dev, or add each as a GitHub Actions secret / Render env var.
# Never commit real values.

# Supabase Postgres. Use the SESSION pooler URI (port 5432) — works for migrations,
# seeding and the app. (Supabase direct connections are IPv6-only and fail from GitHub Actions.)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# PayPal SANDBOX app credentials (Developer dashboard → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. If set, must be "sandbox" — anything else is refused.
PAYPAL_ENV=sandbox

# Comma-separated SANDBOX personal-account emails allowed to receive payouts,
# in this order: Sam, Priya, Jordan, Alex, Casey.
PAYPAL_SANDBOX_RECIPIENTS=

# Set after creating the webhook in the PayPal dashboard (needs the deployed URL).
PAYPAL_WEBHOOK_ID=

# Optional payout limits in pence (hard ceilings £500/item, £2,000/batch apply regardless)
PAYOUT_MAX_ITEM_PENCE=20000
PAYOUT_MAX_BATCH_PENCE=100000

# Milestone 3
OPENAI_API_KEY=
