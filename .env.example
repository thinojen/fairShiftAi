# Copy to .env.local for local dev, or add each as a GitHub Actions secret / Render env var.
# Never commit real values.

# Supabase Postgres. Use the SESSION pooler URI (port 5432) — works for migrations,
# seeding and the app. (Supabase direct connections are IPv6-only and fail from GitHub Actions.)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# PayPal SANDBOX app credentials (Developer dashboard → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. If set, must be "sandbox" — anything else is refused.
PAYPAL_ENV=sandbox

# Comma-separated SANDBOX personal-account emails allowed to receive payouts,
# in this order: Sam, Priya, Jordan, Alex, Casey.
PAYPAL_SANDBOX_RECIPIENTS=

# Set after creating the webhook in the PayPal dashboard (needs the deployed URL).
PAYPAL_WEBHOOK_ID=

# Payout limits in pence. Hard ceilings of £500/item and £2,000/batch apply regardless.
# 30000 (£300) is needed for the demo: Sam's 23 Oct share is £266.46.
PAYOUT_MAX_ITEM_PENCE=30000
PAYOUT_MAX_BATCH_PENCE=100000

# ---- Payout approval (server-side; independent of the demo role switcher) ----
# Payouts are OFF unless this is exactly "true". Leave it off on any public demo.
PAYOUTS_ENABLED=false
# Required to approve a payout. At least 12 characters. Never commit or publish it.
MANAGER_APPROVAL_CODE=

# ---- AI assistant (server-side only; never exposed to the browser) ----
# Free Gemini API tier — no billing needed. Get a key at https://aistudio.google.com
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# "false" switches the assistant off instantly.
AI_ENABLED=true
# Max assistant questions per UTC day across ALL users (in-memory, best-effort).
# A global cap of 5 questions/minute also applies.
AI_DAILY_LIMIT=100
# Optional alternative (PAID): AI_PROVIDER=openai with OPENAI_API_KEY / OPENAI_MODEL.

# Optional: database connections per process (default 5).
DATABASE_POOL_MAX=5
